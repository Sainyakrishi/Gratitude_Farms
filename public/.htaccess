# The site is a single-page app served by Apache/LiteSpeed. A visitor landing
# directly on /about-us asks for a file that does not exist, so the server has
# to answer with the app shell and let the router sort it out. This is the
# Hostinger equivalent of the dist/404.html copy vite.config.js writes for
# GitHub Pages and the redirect rule in netlify.toml.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Anything that exists on disk (assets, favicon) is served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand back the shell.
  RewriteRule ^ index.html [L]
</IfModule>

# Vite fingerprints everything under /build, so those files can be cached hard.
# index.html must not be, or visitors keep loading the old asset names after a
# deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
